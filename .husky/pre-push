#!/bin/sh
set -e


bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
const expectedBunVersionRange = `^${expectedBunVersion}`;
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw new Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`);
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`);
}
'


jetbrains=0
zero=0000000000000000000000000000000000000000

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "$zero" ]; then
    continue
  fi

  base="$remote_oid"
  if [ "$remote_oid" = "$zero" ]; then
    base=$(git merge-base "$local_oid" "$1/main" 2>/dev/null || git hash-object -t tree /dev/null)
  fi

  # Dynamically detect whether JetBrains plugin files changed. Only those
  # changes require the (Java 21 / Gradle) JetBrains typecheck. Other
  # packages are handled by the serial typecheck below, which skips
  # jetbrains because its Kotlin build is broken upstream and unrelated to
  # TS changes.
  if ! git diff --quiet "$base" "$local_oid" -- packages/kappa-jetbrains/**; then
    jetbrains=1
  fi
done




unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# "No-build hotfix": run typecheck SERIALLY per-package. The canary bun SIGSEGVs
# on the FULL parallel turbo typecheck (oven-sh/bun #39967/#39815, open); every
# single-package typecheck passes. BASH_ENV= disables the estate kairos 2s shim
# so long subprocesses aren't SIGINT'd. Only runs packages with a typecheck script.
bun script/typecheck-serial.ts --skip-jetbrains

if [ "$jetbrains" -eq 1 ]; then
  bun typecheck --filter='@kappacode/kappa-jetbrains'
else
  echo "Skipping JetBrains typecheck (no relevant changes)"
fi