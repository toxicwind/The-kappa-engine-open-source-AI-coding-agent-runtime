# shellcheck shell=bash
# kappa-code — direnv first-class.
#
# Model (mirrors the estate .envrc):
#   1. .env.local  -> gitignored, non-secret runtime config (template: .env.example)
#   2. secretsmith-env -> secrets (KAPPA_SERVER_PASSWORD etc.) from the keyring
#   3. watch_file  -> direnv reloads when any config file changes

# 1. Non-secret runtime config (gitignored; template at .env.example)
# shellcheck source=./.env.local
if [[ -f ./.env.local ]]; then
  set -a
  source ./.env.local
  set +a
fi

# 2. Server secret from the secretsmith keyring when available (SSOT).
# Only inject if the caller has not already pinned one in .env.local.
if command -v secretsmith-env >/dev/null 2>&1 && [[ -z "${KAPPA_SERVER_PASSWORD:-}" ]]; then
  set -a
  eval "$(secretsmith-env)"
  set +a
fi

# 3. Reload whenever the config surface changes.
watch_file ./.env.local
watch_file ./.env.example