# Kappa Code environment variables (reference)
#
# Copy this file to `.env` (gitignored) and set only what you need. Kappa reads
# these variables from your shell environment at startup; most are optional and
# have sensible defaults. Verified against packages/core/src/flag/flag.ts and
# packages/core/src/database/database.ts.

# --- Database ---------------------------------------------------------------
# Override the SQLite session database. One of:
#   KAPPA_DB=":memory:"          # ephemeral, in-memory database (tests)
#   KAPPA_DB=/abs/path/k.db      # absolute path anywhere on disk
#   KAPPA_DB=relative.db         # resolved under ~/.local/share/kappa/
# Default: ~/.local/share/kappa/kappa-<channel>.db (see README "Stable session database")
#KAPPA_DB=":memory:"

# --- Build channel / version -------------------------------------------------
# Pin the build channel instead of deriving it from the git branch. Channel
# determines the database filename suffix (kappa-<channel>.db) and the preview
# version string. Valid: "main", "rc", "dev", or any stable branch name.
#KAPPA_CHANNEL="dev"

# Bake a fixed version instead of the branch-based 0.0.0-<branch>-<ts> preview.
#KAPPA_VERSION="1.0.0"

# Trigger an automated version bump during build: patch | minor | major
#KAPPA_BUMP="patch"

# --- Serve / remote access ----------------------------------------------------
# Password/username for the `kappa serve` HTTP server. The estate wrapper
# (estate/bin/kappa-serve.sh) injects these from the secretsmith keyring.
#KAPPA_SERVER_PASSWORD=""
#KAPPA_SERVER_USERNAME=""

# --- Configuration ------------------------------------------------------------
# Path to an explicit config file, or inline config content.
#KAPPA_CONFIG="/path/to/opencode.json"
#KAPPA_CONFIG_CONTENT='{"model":"anthropic/claude-sonnet"}'

# --- Runtime toggles (truthy: "true"/"1") ------------------------------------
#KAPPA_DISABLE_AUTOUPDATE="true"   # skip update checks
#KAPPA_DISABLE_MODELS_FETCH="true" # use the bundled models snapshot only
#KAPPA_DISABLE_TERMINAL_TITLE="true"
#KAPPA_DISABLE_CLAUDE_CODE="true"  # disable Claude Code compatibility shims
#KAPPA_DISABLE_PRUNE="true"

# --- Experimental -------------------------------------------------------------
# Master switch enabling experimental features (gates many KAPPA_*_EXPERIMENTAL_*).
#KAPPA_EXPERIMENTAL="true"

# ---- TUI ---------------------------------------------------------------------
#KAPPA_DISABLE_MOUSE="true"