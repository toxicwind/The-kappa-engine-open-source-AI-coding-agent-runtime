{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@tui/*": ["../tui/src/*"], // kappacode_change - extracted TUI imports used by Kappa-owned components
      "@test/*": ["./test/*"],
      "@kappacode/sdk/v2/types": ["../sdk/js/src/v2/gen/types.gen.ts"],
      "@kappacode/sdk/v2/*": ["../sdk/js/src/v2/*"]
    }
  }
}
