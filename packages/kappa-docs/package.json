{
  "name": "@kappacode/kappa-docs",
  "packageManager": "pnpm@10.0.0",
  "version": "7.8.10",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3002",
    "build": "next build --webpack",
    "lint": "bun run --cwd ../.. lint packages/kappa-docs",
    "start": "next start",
    "test": "vitest run",
    "test:ci": "mkdir -p .artifacts/unit && vitest run --reporter=junit --outputFile=.artifacts/unit/junit.xml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docsearch/css": "^4",
    "@docsearch/js": "^4",
    "@markdoc/markdoc": "^0.5.10",
    "@markdoc/next.js": "^0.5.0",
    "@vscode/codicons": "^0.0.45",
    "@xyflow/react": "12.12.0",
    "js-yaml": "^4.3.2",
    "mermaid": "11.17.2",
    "next": "^16.4.2",
    "posthog-js": "^1.438.12",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {}
}
